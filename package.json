{
  "name": "@joe-broadhead/opencode-granola",
  "version": "0.0.8",
  "description": "Unofficial OpenCode plugin for Granola meeting notes, through Granola's official MCP server",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "granola"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joe-broadhead/opencode-granola.git"
  },
  "homepage": "https://github.com/joe-broadhead/opencode-granola#readme",
  "bugs": {
    "url": "https://github.com/joe-broadhead/opencode-granola/issues"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js",
    "./icon.svg": "./assets/icon.svg",
    "./icon-128.png": "./assets/icon-128.png",
    "./icon-256.png": "./assets/icon-256.png"
  },
  "files": [
    "dist",
    "assets/icon.svg",
    "assets/icon-128.png",
    "assets/icon-256.png",
    "skills",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "opencode": {
    "host": ">=2.2.3 <2.3.0",
    "icons": [
      {
        "src": "assets/icon.svg",
        "mimeType": "image/svg+xml",
        "sizes": [
          "any"
        ]
      },
      {
        "src": "assets/icon-128.png",
        "mimeType": "image/png",
        "sizes": [
          "128x128"
        ]
      },
      {
        "src": "assets/icon-256.png",
        "mimeType": "image/png",
        "sizes": [
          "256x256"
        ]
      }
    ],
    "vendor": {
      "id": "granola",
      "name": "Granola",
      "domain": "granola.ai"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tui.json --noEmit && tsc -p test/tsconfig.json",
    "build": "node scripts/build.mjs",
    "lint": "node scripts/check-forbidden.mjs && node scripts/check-copies.mjs",
    "test": "vitest run",
    "test:host": "bun test --timeout 120000 ./test/integration",
    "test:pack": "node test/pack-smoke.mjs",
    "check": "npm run typecheck && npm run lint && npm run build && npm run icons && npm test && npm run test:host && npm run test:pack && npm run actionlint",
    "icons": "node scripts/check-icons.mjs",
    "actionlint": "node scripts/check-workflows.mjs"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@opencode/client": "2.2.3",
    "@opencode/plugin": "2.2.3",
    "@opencode/sdk": "2.2.3",
    "@opencode/theme": "2.2.3",
    "@opentui/core": "0.8.0",
    "@opentui/solid": "0.8.0",
    "@types/node": "22.20.5",
    "babel-preset-solid": "1.9.16",
    "esbuild": "0.28.2",
    "solid-js": "1.9.16",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "web-tree-sitter": "0.25.10"
  },
  "jelly": {
    "title": "Granola",
    "summary": "Your Granola meetings and notes.",
    "icon": "assets/icon.svg",
    "tools": [
      {
        "name": "granola.get_account_info",
        "permission": "granola_get_account_info",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "granola.list_meeting_folders",
        "permission": "granola_list_meeting_folders",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "granola.list_meetings",
        "permission": "granola_list_meetings",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "granola.search_meetings",
        "permission": "granola_search_meetings",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "granola.get_meetings",
        "permission": "granola_get_meetings",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "granola.get_meeting_transcript",
        "permission": "granola_get_meeting_transcript",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "granola.query_granola_meetings",
        "permission": "granola_query_granola_meetings",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "granola.get_meeting_attachment",
        "permission": "granola_get_meeting_attachment",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "granola.list_templates",
        "permission": "granola_list_templates",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "granola.search_transcripts",
        "permission": "granola_search_transcripts",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "granola.create_folder",
        "permission": "granola_create_folder",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "granola.update_folder",
        "permission": "granola_update_folder",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "granola.add_note_to_folder",
        "permission": "granola_add_note_to_folder",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "granola.remove_note_from_folder",
        "permission": "granola_remove_note_from_folder",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "granola.update_private_notes",
        "permission": "granola_update_private_notes",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "granola.generate_summary",
        "permission": "granola_generate_summary",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "granola.give_feedback",
        "permission": "granola_give_feedback",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "granola.export_markdown",
        "permission": "granola_export_markdown",
        "effect": "allow",
        "readOnly": false
      }
    ],
    "skills": [
      "granola",
      "granola-meeting-brief"
    ],
    "rpc": [],
    "views": [],
    "signIns": [
      {
        "id": "granola",
        "label": "Granola",
        "server": "granola"
      }
    ],
    "contributes": {
      "homeFeeds": [],
      "homeWidgets": [],
      "workKinds": [],
      "settings": []
    }
  }
}
